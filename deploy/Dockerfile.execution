ARG STACKSMITH_IMAGE
FROM ${STACKSMITH_IMAGE}
USER root
COPY --from=platform-wheel / /tmp/platform-wheel/
RUN python -m pip install --no-cache-dir /tmp/platform-wheel/*.whl \
    && rm -rf /tmp/platform-wheel
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["stacksmith-platform-execute"]
