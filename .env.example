# Run the API from the project root. A separate Stacksmith installation is required.
COMPOSER_STACKSMITH_COMMAND=../stacksmith/.venv/bin/stacksmith
# Local path for demo mode, or a git+https GitHub file URL in GitHub mode.
COMPOSER_CONFIG=examples/platform.yaml
# Remove this prefix from module paths returned to the web catalog.
COMPOSER_MODULE_SOURCE_PREFIX=examples
# One trusted config per deployment in this first version.
# GitHub mode requires all three settings below. Leave them unset for local demo mode.
# COMPOSER_GITHUB_CLIENT_ID=
# COMPOSER_GITHUB_CLIENT_SECRET=
# COMPOSER_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
COMPOSER_PUBLIC_URL=http://127.0.0.1:5173
COMPOSER_DATABASE=.data/composer.sqlite3
